# .env.haven.example — SÓ NOMES DE VARIÁVEIS + VALORES FICTÍCIOS.
# Não contém credenciais reais. Em produção, definir nas Variables do Railway;
# a credencial é entregue por canal seguro apenas na ativação coordenada.

# Desligado por defeito. Qualquer valor diferente de "true" = desligado.
HAVEN_INGEST_ENABLED=false

# Endpoint (fictício aqui).
HAVEN_INGEST_URL=https://exemplo-haven.invalid/api/public/yescapa/snapshot

# Credencial exclusiva da integração (FICTÍCIA). Nunca no Git, chat ou logs.
HAVEN_INGEST_TOKEN=FICTICIO_nao_e_uma_credencial_real_000000000000000

# Volume Railway (obrigatório quando ligado) e fila dentro dele.
RAILWAY_VOLUME_MOUNT_PATH=/data
HAVEN_QUEUE_DIR=/data/haven_queue

# Sem chaves Supabase nesta integração.
