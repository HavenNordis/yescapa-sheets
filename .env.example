# ===========================================================================
# .env.example — TEMPLATE (sem segredos). Copiar para ".env" e preencher.
# O ".env" está no .gitignore — NUNCA é commitado. Em PRODUÇÃO, as chaves
# vão nas Variables do Railway, não neste ficheiro.
# ===========================================================================

# --- Supabase / Haven Desk (espelho das reservas) --------------------------
# Ativa o espelho. Se estas duas ficarem vazias, o espelho é no-op (nada muda).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=cola-aqui-a-service_role-key        # service_role (NUNCA no chat/Git)

# Opcionais (têm defaults):
SUPABASE_TABLE=reservas
SUPABASE_SCHEMA=public
# SUPABASE_DRY_RUN=1   # 1 = só imprime o payload nos logs, não escreve. Tirar p/ escrever a sério.

# --- Já existentes em produção (Railway) — aqui só para referência ---------
# YESCAPA_EMAIL=
# YESCAPA_PASSWORD=
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_SHEET_NAME=Reservas Yescapa
# WORKSHEET_NAME=Reservas
